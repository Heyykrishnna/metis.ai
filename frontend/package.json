{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write src test *.ts *.mjs *.json",
    "format:check": "prettier --check src test *.ts *.mjs *.json",
    "contracts:generate": "openapi-typescript ../docs/api/openapi.json -o src/generated/api.d.ts",
    "contracts:check": "openapi-typescript ../docs/api/openapi.json -o src/generated/api.d.ts --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:run && npm run contracts:check && npm run build"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
